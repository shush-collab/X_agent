# GOAL: Prevent sensitive/irrelevant files from being committed
# PURPOSE: Security and repository cleanliness
# RESPONSIBILITY: Filter out credentials, cache, logs, and build artifacts

# Environment
.env
*.env.local

# Data
data/
snapshots/
logs/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/

# Playwright
playwright/.cache/
config/x_storage_state.json
